{
  "name": "Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:Asia/Tokyo}",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },
  "features": {
    // --- Languages (uncomment what you need) ---
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    // "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    // "ghcr.io/devcontainers/features/rust:1": { "profile": "minimal" },
    // "ghcr.io/devcontainers/features/go:1": { "version": "latest" },
    // "ghcr.io/devcontainers/features/java:1": { "version": "21" },
    // "ghcr.io/devcontainers/features/ruby:1": { "version": "latest" },
    // "ghcr.io/devcontainers-extra/features/elixir-asdf:1": {} // archived; use with caution

    // --- Tools (uncomment what you need) ---
    "ghcr.io/devcontainers/features/github-cli:1": {}
    // "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {},
    // "ghcr.io/devcontainers/features/terraform:1": {}
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },
  "remoteUser": "dev",
  "mounts": [
    "source=sandbox-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=sandbox-claude-config-${devcontainerId},target=/home/dev/.claude,type=volume",
    "source=sandbox-projects,target=/home/dev/projects,type=volume"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true"
  },
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code @openai/codex pnpm",
  "postStartCommand": "[ -f /usr/local/bin/init-firewall.sh ] && sudo /usr/local/bin/init-firewall.sh || true",
  "waitFor": "postStartCommand",
  "workspaceFolder": "/workspace"
}
