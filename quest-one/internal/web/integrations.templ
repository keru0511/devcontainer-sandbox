package web

import (
	"github.com/quest-one/quest-one/internal/domain"
)

templ IntegrationsPage(integrations []domain.Integration) {
	@Layout("Integrations") {
		<div class="page-header">
			<h1>Integrations</h1>
		</div>
		if len(integrations) == 0 {
			<div class="empty-state">No integrations configured yet.</div>
		} else {
			<div class="card">
				for _, i := range integrations {
					@IntegrationRow(i)
				}
			</div>
		}
		<div class="card" style="margin-top:1.5rem">
			<h2>Add Integration</h2>
			<form hx-post="/api/v1/integrations" hx-ext="json-enc" hx-target="body">
				<div class="form-group">
					<label>Provider</label>
					<select name="provider">
						<option value="redmine">Redmine</option>
						<option value="slack">Slack</option>
						<option value="gcal">Google Calendar</option>
						<option value="notepm">NotePM</option>
						<option value="gdrive">Google Drive</option>
					</select>
				</div>
				<div class="form-group">
					<label>Display Name</label>
					<input type="text" name="name" placeholder="e.g. Work Redmine"/>
				</div>
				<div class="form-group">
					<label>Base URL</label>
					<input type="url" name="base_url" placeholder="https://redmine.example.com"/>
				</div>
				<button type="submit" class="btn btn-primary">Add</button>
			</form>
		</div>
	}
}

templ IntegrationRow(i domain.Integration) {
	<div class="task-row" id={ "integration-" + string(i.ID) }>
		<span class={ integrationStatusClass(i.Enabled) }>{ integrationStatusLabel(i.Enabled) }</span>
		<span class="task-title">{ i.Name } <span style="color:var(--muted);font-size:0.8rem">({ string(i.Provider) })</span></span>
		<span style="color:var(--muted);font-size:0.8rem">{ i.BaseURL }</span>
		<div style="display:flex;gap:0.25rem">
			if i.Enabled {
				<button
					class="btn btn-sm"
					hx-post={ "/api/v1/integrations/" + string(i.ID) + "/disable" }
					hx-target={ "#integration-" + string(i.ID) }
					hx-swap="outerHTML"
				>Disable</button>
			} else {
				<button
					class="btn btn-sm btn-primary"
					hx-post={ "/api/v1/integrations/" + string(i.ID) + "/enable" }
					hx-target={ "#integration-" + string(i.ID) }
					hx-swap="outerHTML"
				>Enable</button>
			}
			<button
				class="btn btn-sm btn-danger"
				hx-delete={ "/api/v1/integrations/" + string(i.ID) }
				hx-target={ "#integration-" + string(i.ID) }
				hx-swap="outerHTML"
				hx-confirm="Delete this integration?"
			>Delete</button>
		</div>
	</div>
}

func integrationStatusClass(enabled bool) string {
	if enabled {
		return "task-status status-in_progress"
	}
	return "task-status status-todo"
}

func integrationStatusLabel(enabled bool) string {
	if enabled {
		return "enabled"
	}
	return "disabled"
}
