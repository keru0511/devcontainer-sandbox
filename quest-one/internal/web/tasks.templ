package web

import (
	"fmt"
	"github.com/quest-one/quest-one/internal/domain"
)

templ TasksPage(tasks []domain.Task) {
	@Layout("Tasks") {
		<div class="page-header">
			<h1>Tasks</h1>
			<a href="/tasks/new" class="btn btn-primary">+ New Task</a>
		</div>
		<div class="search-bar">
			<input
				type="search"
				name="q"
				placeholder="Search tasks…"
				hx-get="/tasks/search"
				hx-trigger="input changed delay:300ms, search"
				hx-target="#task-list"
				hx-indicator="#search-spinner"
			/>
			<span id="search-spinner" class="htmx-indicator">…</span>
		</div>
		<div id="task-list">
			@TaskList(tasks)
		</div>
	}
}

templ TaskList(tasks []domain.Task) {
	if len(tasks) == 0 {
		<div class="empty-state">No tasks yet. Add one above!</div>
	} else {
		<div class="card">
			for _, task := range tasks {
				@TaskRow(task)
			}
		</div>
	}
}

templ TaskRow(task domain.Task) {
	<div class="task-row" id={ "task-" + string(task.ID) }>
		<span class={ "task-status status-" + string(task.Status) }>{ string(task.Status) }</span>
		<a href={ templ.SafeURL("/tasks/" + string(task.ID)) } class="task-title">{ task.Title }</a>
		@PriorityBadge(task.Priority)
		if task.IsActive() {
			<div style="display:flex;gap:0.25rem">
				<button
					class="btn btn-sm"
					hx-post={ "/tasks/" + string(task.ID) + "/promote" }
					hx-target={ "#task-" + string(task.ID) }
					hx-swap="outerHTML"
					title="Promote"
				>↑</button>
				<button
					class="btn btn-sm btn-primary"
					hx-post={ "/tasks/" + string(task.ID) + "/complete" }
					hx-target={ "#task-" + string(task.ID) }
					hx-swap="outerHTML"
					title="Complete"
				>✓</button>
			</div>
		}
	</div>
}

templ PriorityBadge(p domain.PriorityScore) {
	<span class={ priorityBadgeClass(p) }>{ priorityLabel(p) }</span>
}

templ NewTaskPage() {
	@Layout("New Task") {
		<h1>New Task</h1>
		<div class="card">
			<form
				hx-post="/tasks"
				hx-target="#task-list"
				hx-swap="beforeend"
				hx-on::after-request="this.reset()"
			>
				<div class="form-group">
					<label for="title">Title *</label>
					<input id="title" name="title" type="text" required placeholder="What needs to be done?"/>
				</div>
				<div class="form-group">
					<label for="description">Description</label>
					<textarea id="description" name="description" placeholder="Optional details…"></textarea>
				</div>
				<div class="form-group">
					<label for="due_date">Due Date</label>
					<input id="due_date" name="due_date" type="date"/>
				</div>
				<button type="submit" class="btn btn-primary">Add Task</button>
				<a href="/tasks" class="btn" style="margin-left:0.5rem">Cancel</a>
			</form>
		</div>
	}
}

templ TaskDetailPage(task domain.Task) {
	@Layout(task.Title) {
		<div class="page-header">
			<h1>{ task.Title }</h1>
			<span class={ "task-status status-" + string(task.Status) }>{ string(task.Status) }</span>
		</div>
		<div class="card">
			if task.Description != "" {
				<p style="color:var(--muted);margin-bottom:1rem">{ task.Description }</p>
			}
			<div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1rem">
				for _, tag := range task.Tags {
					<span class="tag">{ tag }</span>
				}
			</div>
			if task.DueDate != nil {
				<p><strong>Due:</strong> { task.DueDate.Format("2006-01-02") }</p>
			}
			<p style="margin-top:0.5rem;color:var(--muted);font-size:0.8rem">
				Created { task.CreatedAt.Format("2006-01-02 15:04") }
			</p>
		</div>
		if task.IsActive() {
			<div class="card">
				<h2>Actions</h2>
				<div style="display:flex;gap:0.5rem;flex-wrap:wrap">
					<button
						class="btn btn-sm"
						hx-post={ "/tasks/" + string(task.ID) + "/promote" }
						hx-target="body"
						hx-push-url="true"
					>↑ Promote</button>
					<button
						class="btn btn-sm btn-primary"
						hx-post={ "/tasks/" + string(task.ID) + "/complete" }
						hx-target="body"
						hx-push-url="/tasks"
					>✓ Complete</button>
					<button
						class="btn btn-sm btn-danger"
						hx-post={ "/tasks/" + string(task.ID) + "/cancel" }
						hx-target="body"
						hx-push-url="/tasks"
					>✕ Cancel</button>
				</div>
			</div>
		}
		<div class="card">
			<h2>Memo</h2>
			<form hx-post={ "/tasks/" + string(task.ID) + "/memo" } hx-target="body">
				<div class="form-group">
					<textarea name="memo" placeholder="Notes, context, links…">{ task.Memo }</textarea>
				</div>
				<button type="submit" class="btn btn-sm btn-primary">Save Memo</button>
			</form>
		</div>
	}
}

// ---- helpers (Go functions, not templ components) ----

func priorityBadgeClass(p domain.PriorityScore) string {
	switch {
	case p.ManualUrgency >= domain.UrgencyCritical:
		return "priority-badge priority-critical"
	case p.ManualUrgency >= domain.UrgencyHigh:
		return "priority-badge priority-high"
	default:
		return "priority-badge"
	}
}

func priorityLabel(p domain.PriorityScore) string {
	switch p.ManualUrgency {
	case domain.UrgencyCritical:
		return "CRITICAL"
	case domain.UrgencyHigh:
		return "HIGH"
	case domain.UrgencyMedium:
		return "MED"
	case domain.UrgencyLow:
		return "LOW"
	default:
		return fmt.Sprintf("P%d", p.DeadlineUrgency/25+1)
	}
}
