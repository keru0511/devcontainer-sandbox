package web

import (
	"fmt"
	"github.com/quest-one/quest-one/internal/domain"
)

templ SettingsPage(s domain.Settings) {
	@Layout("Settings") {
		<h1>Settings</h1>
		<div class="card">
			<form hx-put="/api/v1/settings" hx-ext="json-enc">
				<div class="form-group">
					<label>Server Port</label>
					<input type="number" name="server_port" value={ fmt.Sprintf("%d", s.ServerPort) }/>
				</div>
				<div class="form-group">
					<label>Data Directory</label>
					<input type="text" name="data_dir" value={ s.DataDir }/>
				</div>
				<div class="form-group">
					<label>Language</label>
					<select name="language">
						<option value="en" selected?={ s.Language == "en" }>English</option>
						<option value="ja" selected?={ s.Language == "ja" }>日本語</option>
					</select>
				</div>
				<div class="form-group">
					<label>LLM Provider</label>
					<select name="llm_provider">
						<option value="none" selected?={ s.LLMProvider == "none" }>None</option>
						<option value="anthropic" selected?={ s.LLMProvider == "anthropic" }>Anthropic (Claude)</option>
						<option value="openai" selected?={ s.LLMProvider == "openai" }>OpenAI</option>
					</select>
				</div>
				<div class="form-group">
					<label>Max Candidates</label>
					<input type="number" name="max_candidates" value={ fmt.Sprintf("%d", s.MaxCandidates) } min="1" max="20"/>
				</div>
				<div class="form-group">
					<label>Auto Sync Interval (minutes, 0 = disabled)</label>
					<input type="number" name="auto_sync_interval_minutes" value={ fmt.Sprintf("%d", s.AutoSyncIntervalMinutes) } min="0"/>
				</div>
				<button type="submit" class="btn btn-primary">Save Settings</button>
			</form>
		</div>
	}
}
